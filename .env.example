# =====================================================================
# tgo-sandesh · Extreme or Nothing Protocol
# Copy to .env.local and fill. Every var below is READ somewhere in the
# code, and every process.env in the code has a var here. Nothing
# aspirational.
#
# THE FUNNEL (paid):
#   /            landing          ViewContent; every CTA -> AddToCart
#   /checkout    details + Pay    InitiateCheckout (on Pay)
#   Razorpay     payment          Purchase (verify + webhook + pixel), Pabbly row
#   /book        Cal.com slot     Schedule (on a completed booking)
#   /thank-you   confirmation     nothing
#
# Every Meta event goes to BOTH the browser pixel and the Conversions API
# with one shared event_id (Meta deduplicates), and the CAPI copy carries
# hashed email, phone, first/last name, city, country and external_id plus
# fbp, fbc, client IP and user agent. That is what lifts Event Match
# Quality.
# =====================================================================


# ---------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------
# The live origin, with protocol and no trailing slash.
# e.g. https://transformmebro.com
#
# Read by: src/app/layout.tsx (metadataBase) and src/lib/tracking-config.ts
# (fallbackEventSourceUrl: Meta's event_source_url, and the absolute
# booking_url sent to Pabbly).
#
# WITHOUT IT: both fall back to https://transformmebro.com. The fallback
# literal appears in TWO files and they must match.
NEXT_PUBLIC_SITE_URL=


# ---------------------------------------------------------------------
# PRICE
# ---------------------------------------------------------------------
# The booking fee in whole rupees. ONE number behind everything: the
# checkout label, the Razorpay charge (x100 paise), the Meta and GA4
# `value`, the landing page and the policies.
#
# NEXT_PUBLIC_ because the browser renders it, which also means it is
# inlined at BUILD time: change it, then rebuild / redeploy.
#
# WITHOUT IT: 97.
NEXT_PUBLIC_CHECKOUT_PRICE_INR=97


# ---------------------------------------------------------------------
# RAZORPAY  ·  Dashboard -> Account & Settings -> API Keys
# ---------------------------------------------------------------------
# rzp_test_... while testing, rzp_live_... for launch. The key id is
# publishable (the browser needs it to open the sheet; create-order hands
# it over); the secret never leaves the server.
#
# WITHOUT THEM: /api/razorpay/create-order returns 503 and the checkout
# says "Payments are not switched on yet. Nothing has been charged."
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard -> Account & Settings -> Webhooks -> Add New Webhook
#   URL:    <NEXT_PUBLIC_SITE_URL>/api/razorpay/webhook
#   Events: payment.captured
#   Secret: any strong string, pasted here too. It is a DIFFERENT value
#           from RAZORPAY_KEY_SECRET.
#
# WITHOUT IT: the webhook rejects everything with a 500. Purchase still
# reaches Meta from /api/razorpay/verify when the buyer's tab survives
# the payment, but the Pabbly "purchase" row is sent ONLY by the webhook.
# (Razorpay cannot reach localhost: to test the webhook locally, expose
# the dev server with a tunnel such as ngrok and register that URL.)
RAZORPAY_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
# META  ·  Events Manager -> Data Sources -> your dataset
# ---------------------------------------------------------------------
# The same pixel id, twice. NEXT_PUBLIC_ is inlined into the browser
# bundle for the pixel; the unprefixed one is read server-side by CAPI.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=

# Conversions API access token: dataset -> Settings -> Conversions API
# -> Generate access token. A long EAA... string.
#
# WITHOUT IT: capiReady() is false and every server-side Meta event is
# skipped silently; only the browser pixel copies reach Meta.
META_CAPI_ACCESS_TOKEN=

# ⚠️ REMOVE THIS BEFORE LAUNCH. Events sent with a test event code go to
# the Test Events tab and DO NOT COUNT toward optimisation.
META_CAPI_TEST_EVENT_CODE=

# NOT ENV, BUT REQUIRED FOR THE AD COLUMNS: set this as the URL
# parameters on every Meta ad (Ad -> Tracking -> URL parameters):
#
#   utm_source=facebook&utm_medium={{adset.name}}&utm_campaign={{campaign.name}}&utm_content={{ad.name}}&utm_term={{ad.id}}&campaign_id={{campaign.id}}&adset_id={{adset.id}}&ad_id={{ad.id}}&campaign_name={{campaign.name}}&adset_name={{adset.name}}&ad_name={{ad.name}}&placement={{placement}}&site_source_name={{site_source_name}}
#
# Each is captured on first landing (middleware cookie + localStorage),
# written into the Razorpay order and sent to Pabbly on the purchase row.


# ---------------------------------------------------------------------
# GA4  ·  Admin -> Data Streams -> your web stream
# ---------------------------------------------------------------------
# Measurement ID, the G-XXXXXXXXXX at the top of the stream.
#
# WITHOUT IT: no GA4 base tag; view_item, add_to_cart, begin_checkout and
# purchase are silent no-ops.
NEXT_PUBLIC_GA4_ID=


# ---------------------------------------------------------------------
# PABBLY  ·  Connect -> your workflow -> the Webhook trigger step
# ---------------------------------------------------------------------
# The SAME workflow URL as before. It receives ONE row per buyer, only
# when the payment is captured (from the webhook), `event` = "purchase".
# It carries first_name, last_name, email, phone, city, country_code,
# dial_code, every utm_*, campaign_id / adset_id / ad_id, their names,
# placement, site_source_name, fbclid, fbc, fbp, IP, user agent,
# external_id, ga_client_id, order_id, payment_id and the Meta event ids.
#
# Pabbly builds its field map from the FIRST payload it sees: push one
# test payment through before mapping, and re-capture the sample.
#
# WITHOUT IT: the row is skipped quietly. Payments and Meta are
# unaffected.
PABBLY_WEBHOOK_URL=


# ---------------------------------------------------------------------
# CLARITY  ·  clarity.microsoft.com -> project -> Setup
# ---------------------------------------------------------------------
# Session recordings and heatmaps only; not part of the conversion rail.
NEXT_PUBLIC_CLARITY_ID=


# =====================================================================
# REQUIRED BEFORE LAUNCH, BUT NOT ENV
# =====================================================================
# 1. Delete META_CAPI_TEST_EVENT_CODE and switch to rzp_live_ keys.
# 2. Register the Razorpay webhook (above).
# 3. src/app/_legal/legal.ts: `effectiveDate` must match the day the
#    policies actually go live.
# 4. Everything else still open is listed in PENDING.md.
